{
  "name": "@kud/segment-ink",
  "version": "0.1.0",
  "description": "Ink components for browsing Segment sources, destinations, and the destination catalog",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "segment",
    "analytics",
    "sources",
    "destinations",
    "catalog",
    "ink",
    "tui"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kud/segment",
    "directory": "packages/segment-ink"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@kud/ink-ui": "0.14.0",
    "@kud/segment": "0.1.1"
  },
  "peerDependencies": {
    "ink": ">=7",
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.14",
    "ink": "7.1.0",
    "ink-testing-library": "4.0.0",
    "react": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
