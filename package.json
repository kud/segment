{
  "name": "kud-segment-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The @kud/segment family — Segment Public API tooling: a surface-agnostic core and a thin CLI.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @kud/segment && npm run build -w @kud/segment-ink && npm run build -w @kud/segment-cli",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "segment",
    "analytics",
    "cli",
    "destinations",
    "monorepo"
  ],
  "author": "Erwann Mest <m@kud.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/segment.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "typescript": "5.9.3"
  }
}
